# Prepare a build-local libvirtualhid tree without changing the submodule.
function(_sunshine_lvh_tree_hash directory result)
    file(GLOB_RECURSE files LIST_DIRECTORIES false RELATIVE "${directory}" "${directory}/*")
    list(FILTER files EXCLUDE REGEX "(^|/)\\.git(/|$)")
    list(SORT files)
    set(manifest "")
    foreach(path IN LISTS files)
        if(IS_SYMLINK "${directory}/${path}")
            message(FATAL_ERROR "libvirtualhid source contains a symlink: ${path}")
        endif()
        file(SHA256 "${directory}/${path}" hash)
        string(APPEND manifest "${path}:${hash}\n")
    endforeach()
    string(SHA256 hash "${manifest}")
    set(${result} "${hash}" PARENT_SCOPE)
endfunction()

function(sunshine_add_patched_libvirtualhid)
    set(source "${CMAKE_SOURCE_DIR}/third-party/libvirtualhid")
    set(patch "${CMAKE_SOURCE_DIR}/cmake/patches/libvirtualhid-linux-key-mapping.patch")
    set(copy "${CMAKE_BINARY_DIR}/_sunshine_libvirtualhid/source")
    set(stamp "${CMAKE_BINARY_DIR}/_sunshine_libvirtualhid/complete")
    set(expected_commit "53e1a949fc0784af716b782ddfa6c647cafd1f05")
    set(expected_patch "7d23c39b59b48ccadee06ddbd93c028e6a1027bdc529de8967cabf2c1a612fb1")

    find_package(Git REQUIRED)
    find_program(SUNSHINE_PATCH_EXECUTABLE NAMES patch REQUIRED)
    file(SHA256 "${patch}" patch_hash)
    if(NOT patch_hash STREQUAL expected_patch)
        message(FATAL_ERROR "Unexpected libvirtualhid mapper patch; use the checked-in patch unchanged")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" rev-parse --show-toplevel
        RESULT_VARIABLE result OUTPUT_VARIABLE root OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    file(REAL_PATH "${source}" source_real)
    if(NOT result EQUAL 0 OR NOT root STREQUAL source_real)
        message(FATAL_ERROR "Initialize the pinned libvirtualhid submodule at ${source}")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" rev-parse HEAD
        RESULT_VARIABLE result OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT result EQUAL 0 OR NOT revision STREQUAL expected_commit)
        message(FATAL_ERROR "libvirtualhid must be checked out at ${expected_commit}")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" status --porcelain=v1
        --untracked-files=all --ignored --ignore-submodules=none
        RESULT_VARIABLE result OUTPUT_VARIABLE dirty ERROR_VARIABLE error)
    if(NOT result EQUAL 0 OR NOT dirty STREQUAL "")
        message(FATAL_ERROR "libvirtualhid must be clean, including untracked and ignored files: ${error}\n${dirty}")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" submodule status --recursive
        RESULT_VARIABLE result OUTPUT_VARIABLE submodules ERROR_VARIABLE error)
    if(NOT result EQUAL 0 OR submodules MATCHES "(^|\n)[+U]")
        message(FATAL_ERROR "libvirtualhid nested submodules are invalid: ${error}\n${submodules}")
    endif()

    _sunshine_lvh_tree_hash("${source}" source_hash)
    if(EXISTS "${stamp}")
        file(READ "${stamp}" expected_hashes)
        if(NOT IS_DIRECTORY "${copy}")
            message(FATAL_ERROR "Patched libvirtualhid copy is missing; use a fresh build directory")
        endif()
        _sunshine_lvh_tree_hash("${copy}" copy_hash)
        if(NOT expected_hashes STREQUAL "${source_hash}\n${patch_hash}\n${copy_hash}\n")
            message(FATAL_ERROR "libvirtualhid source, patch, or build-local copy changed; use a fresh build directory")
        endif()
    else()
        if(EXISTS "${copy}" OR IS_SYMLINK "${copy}")
            message(FATAL_ERROR "Incomplete libvirtualhid copy exists; use a fresh build directory")
        endif()
        file(MAKE_DIRECTORY "${copy}")
        file(COPY "${source}/" DESTINATION "${copy}" PATTERN ".git" EXCLUDE)
        _sunshine_lvh_tree_hash("${copy}" copied_source_hash)
        _sunshine_lvh_tree_hash("${source}" source_hash_after_copy)
        if(NOT copied_source_hash STREQUAL source_hash OR NOT source_hash_after_copy STREQUAL source_hash)
            message(FATAL_ERROR "libvirtualhid source changed during copying; use a fresh build directory")
        endif()
        execute_process(COMMAND "${SUNSHINE_PATCH_EXECUTABLE}" -p1 --batch --forward --fuzz=0 --dry-run -i "${patch}"
            WORKING_DIRECTORY "${copy}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Cannot apply libvirtualhid mapper patch: ${output}\n${error}")
        endif()
        execute_process(COMMAND "${SUNSHINE_PATCH_EXECUTABLE}" -p1 --batch --forward --fuzz=0 -i "${patch}"
            WORKING_DIRECTORY "${copy}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Applying libvirtualhid mapper patch failed: ${output}\n${error}")
        endif()
        _sunshine_lvh_tree_hash("${copy}" copy_hash)
        file(WRITE "${stamp}" "${source_hash}\n${patch_hash}\n${copy_hash}\n")
    endif()
    add_subdirectory("${copy}" "${CMAKE_BINARY_DIR}/_sunshine_libvirtualhid/build")
endfunction()
